{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "guy-portfolio-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "services": [
    {
      "binding": "JARVIS",
      "service": "teara-jarvis"
    }
  ],
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "730219",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
